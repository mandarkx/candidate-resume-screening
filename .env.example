# LLM Provider configuration
# Supported: openai, gemini, mock
# Required: set LLM_PROVIDER and paste your API key as LLM_API_KEY.
#
# For an OpenAI key:
#   LLM_PROVIDER=openai   LLM_MODEL=gpt-4o-mini
# For a Google Gemini (AI Studio) key:
#   LLM_PROVIDER=gemini   LLM_MODEL=gemini-2.5-flash
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4000

# Optional: base URL override (for Azure/proxy endpoints, or a custom Gemini endpoint)
LLM_BASE_URL=

# Optional: path to a PEM CA bundle to trust for LLM API calls (e.g. DoD PKI)
# This is applied as the agent CA for the OpenAI provider.
LLM_CA_CERT=

# Optional: HTTPS proxy for LLM API calls, e.g. https://proxy.defense.mil:8080
LLM_HTTPS_PROXY=

# Optional: also export the CA bundle to Node's global TLS store for other
# outbound connections (PDF service Chromium uses the OS store, not this).
# NODE_EXTRA_CA_CERTS=C:\path\to\ca-bundle.pem
# NODE_USE_SYSTEM_CA=1

# Application configuration
PORT=3000
NODE_ENV=development

# Upload and storage limits
MAX_FILE_SIZE_MB=10
MAX_RESUMES=50
MAX_JD_FILES=1
OUTPUT_DIR=./output
UPLOAD_DIR=./uploads

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
