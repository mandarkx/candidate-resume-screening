# LLM Provider configuration
# Supported: openai, mock
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4000

# Optional: OpenAI base URL (for Azure or proxy endpoints)
LLM_BASE_URL=

# Application configuration
PORT=3000
NODE_ENV=development

# Upload and storage limits
MAX_FILE_SIZE_MB=10
MAX_RESUMES=50
MAX_JD_FILES=1
OUTPUT_DIR=./output
UPLOAD_DIR=./uploads

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
