{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "module": "NodeNext",
    "moduleResolution": "nodenext"
  },
  "include": ["src/server/**/*", "src/extraction/**/*", "src/prompts/**/*", "src/llm/**/*", "src/schemas/**/*", "src/evaluation/**/*", "src/reports/**/*", "src/storage/**/*", "src/utils/**/*", "src/shared/**/*"],
  "exclude": ["src/client/**/*"]
}
